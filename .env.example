# Copy to .env and fill in real values. Never commit the real .env file.

# --- General ---
ENVIRONMENT=development
LOG_LEVEL=info

# --- Postgres ---
POSTGRES_USER=lial
POSTGRES_PASSWORD=
POSTGRES_DB=lial_energy
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://lial:@postgres:5432/lial_energy

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Auth ---
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- Storage (MinIO in dev, S3-compatible in production) ---
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_DOCUMENTS=lial-documents
S3_REGION=eu-central-1
S3_USE_SSL=false

# --- MinIO (dev only, controls the minio container itself) ---
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# --- Frontend (BFF) ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
API_INTERNAL_URL=http://api:8000
