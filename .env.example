# Copy to .env and fill in real values. Never commit the real .env file.

# --- General ---
ENVIRONMENT=development
LOG_LEVEL=info

# --- Postgres ---
POSTGRES_USER=lial
POSTGRES_PASSWORD=
POSTGRES_DB=lial_energy
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://lial:@postgres:5432/lial_energy

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Auth ---
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- Storage (MinIO in dev, S3-compatible in production) ---
# S3_ACCESS_KEY/S3_SECRET_KEY MUST be IDENTICAL to MINIO_ROOT_USER/
# MINIO_ROOT_PASSWORD below -- these are two names for the SAME credential
# pair. If you generate them separately you WILL get SignatureDoesNotMatch on
# every request (this happened for real on the reference server, see
# server-migration-guide.md §8).
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_DOCUMENTS=lial-documents
# Public-read bucket for profile/product photos -- separate from the private
# documents bucket above. Auto-created (with its public-read policy) by the
# api container on startup; nothing to do here except leave the default or
# rename consistently.
S3_BUCKET_MEDIA=lial-media
S3_REGION=eu-central-1
S3_USE_SSL=false

# --- MinIO (dev only, controls the minio container itself) ---
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
# Must match S3_REGION above -- MinIO defaults to us-east-1 otherwise, which
# breaks SigV4 signature verification for a client signing for a different
# region (see server-migration-guide.md §8).
MINIO_REGION=eu-central-1

# --- Frontend (BFF) ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
API_INTERNAL_URL=http://api:8000
# Same public URL as NEXT_PUBLIC_APP_URL -- used server-side by the API to
# build every link/CTA button inside an outbound email (password reset,
# OTP codes, cashback credited, order/redemption notifications, ...), since
# the API is never addressed directly by end users (see nginx.conf).
PUBLIC_APP_BASE_URL=http://localhost:3000

# --- Outbound email (optional, but powers every email in the app) ---
# Leave SMTP_HOST empty to run without real delivery: password-reset links
# still work (written to the api container's log instead of emailed, see
# business-rules.md §Password reset), but every OTHER email (OTP codes for
# spending wallet credit, cashback-credited notifications, order/redemption
# confirmations, ticket alerts, ...) is also just skipped/logged -- most of
# this app's self-service flows are much smoother with real SMTP configured.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=no-reply@example.com
SMTP_USE_TLS=true

# --- API docs exposure ---
# /backend/docs, /backend/redoc, /backend/openapi.json are reachable directly
# from the internet (see infrastructure/nginx/nginx.conf) if this is true.
# Set to false for a real production deployment -- see security-model.md.
ENABLE_API_DOCS=true

# --- Bank transfer bootstrap fallback (optional) ---
# Only read when Organization.settings.bank_iban is unset in the database --
# the real, live value is set from the admin dashboard (Impostazioni
# Azienda), which always wins once configured. Leave COMPANY_BANK_IBAN empty
# to have every "pay by bank transfer" screen show "contatta
# l'amministrazione" instead of a fake IBAN until an admin sets the real one
# -- see business-rules.md and server-migration-guide.md §4.2.
COMPANY_BANK_IBAN=
COMPANY_BANK_HOLDER=

# --- Stripe (card payments) ---
# NOT set here -- Stripe publishable/secret/webhook keys are stored in
# Organization.settings (DB-backed), configurable ONLY by a SUPER_ADMIN from
# the admin dashboard (Impostazioni Azienda -> Pagamenti), never as an
# environment variable. Nothing to fill in below; listed only so this file
# stays the complete map of every configuration surface this app has -- see
# business-rules.md §Partner-invoice cashback and security-model.md.
